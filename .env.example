# Copy this file to .env and pick ONE model line.
# Format is "provider:model-name" (LangChain's init_chat_model understands it).

# Option A - free & local (install Ollama, then: ollama pull llama3.1)
LLM_MODEL=ollama:llama3.1

# Option B - OpenAI
# LLM_MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Option C - Anthropic
# LLM_MODEL=anthropic:claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...
